{
  "name": "hoverboard",
  "version": "3.0.0",
  "type": "module",
  "private": true,
  "description": "Conference website template",
  "engines": {
    "node": "22",
    "npm": "10"
  },
  "scripts": {
    "build": "npm run clean && NODE_ENV=production VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build && NODE_ENV=production VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build --config vite.sw.config.ts",
    "clean": "rm -rf dist",
    "deploy": "npm run build && NODE_ENV=production firebase deploy",
    "firestore:copy": "ts-node-script ./scripts/firestore-copy",
    "firestore:copy:production": "FIRESTORE_TARGET=production ts-node-script ./scripts/firestore-copy",
    "firestore:export": "firebase emulators:export ./.firebase/emulator-data --only firestore --force",
    "firestore:init": "ts-node-script ./scripts/firestore-init",
    "firestore:init:production": "FIRESTORE_TARGET=production ts-node-script ./scripts/firestore-init",
    "fix": "concurrently npm:fix:*",
    "fix:eslint": "eslint . --fix",
    "fix:prettier": "prettier . --write",
    "install:functions": "npm --prefix ./functions ci",
    "lint": "concurrently npm:lint:*",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:types:functions": "npm --prefix ./functions run build",
    "lint:types:web": "tsc --noEmit",
    "postinstall": "npm run install:functions",
    "serve": "NODE_ENV=production concurrently --kill-others npm:start:*",
    "start": "npm run clean && NODE_ENV=development concurrently --kill-others npm:start:*",
    "start:emulators": "firebase emulators:start --import=./.firebase/emulator-data --export-on-exit",
    "start:functions": "npm --prefix functions start",
    "start:vite": "mkdir -p dist && VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build --watch",
    "start:vite-sw": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build --watch --config vite.sw.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@abraham/remotedata": "1.4.0",
    "@justinribeiro/lite-youtube": "^1.9.0",
    "@material/mwc-dialog": "^0.27.0",
    "@material/mwc-formfield": "^0.27.0",
    "@material/mwc-icon-button": "^0.27.0",
    "@material/mwc-snackbar": "^0.27.0",
    "@material/mwc-switch": "^0.27.0",
    "@material/web": "^2.5.0",
    "@power-elements/lazy-image": "^2.2.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@vaadin/router": "^2.0.1",
    "firebase": "^10.14.1",
    "lit": "^3.3.3",
    "marked": "^18.0.11",
    "marked-gfm-heading-id": "^4.1.4",
    "pwa-helpers": "^0.9.1",
    "register-service-worker": "^1.7.2"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@html-eslint/eslint-plugin": "^0.65.0",
    "@html-eslint/parser": "^0.65.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/marked": "^6.0.0",
    "@types/node": "^26.4.0",
    "@types/nunjucks": "^3.2.6",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.5.1",
    "globals": "^17.11.0",
    "jest-dev-server": "^11.0.0",
    "jsdom": "^30.1.1",
    "nunjucks": "^3.2.4",
    "prettier": "3.9.6",
    "prettier-plugin-package": "2.0.0",
    "rollup": "^4.63.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-workbox": "^9.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "contributors": [
    "Oleh Zasadnyy, GDG Lviv",
    "Sophie Huts, GDG Lviv",
    "Abraham Williams, GDG Madison"
  ],
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.44.0"
  }
}
