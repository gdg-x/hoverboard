{
  "name": "hoverboard",
  "version": "3.0.0",
  "type": "module",
  "private": true,
  "description": "Conference website template",
  "engines": {
    "node": "22",
    "npm": "10"
  },
  "scripts": {
    "build": "npm --prefix ./packages/web run build",
    "clean": "npm --prefix ./packages/web run clean",
    "deploy": "npm --prefix ./packages/cli run deploy --",
    "doctor": "npm --prefix ./packages/cli run doctor",
    "emulators": "npm --prefix ./packages/cli run emulators",
    "firestore:copy": "npm --prefix ./packages/cli run firestore-copy",
    "firestore:copy:production": "npm --prefix ./packages/cli run firestore-copy:production",
    "firestore:export": "npm --prefix ./packages/cli run firestore-export",
    "firestore:init": "npm --prefix ./packages/cli run firestore-init",
    "firestore:init:production": "npm --prefix ./packages/cli run firestore-init:production",
    "fix": "concurrently npm:fix:*",
    "fix:eslint": "eslint . --fix",
    "fix:prettier": "prettier . --write",
    "install:cli": "npm --prefix ./packages/cli ci",
    "install:server": "npm --prefix ./packages/server run install:functions",
    "install:storage": "npm --prefix ./packages/storage ci",
    "install:web": "npm --prefix ./packages/web ci",
    "lint": "concurrently npm:lint:*",
    "lint:eslint": "eslint .",
    "lint:lit-analyzer": "npm --prefix ./packages/web run lint:lit-analyzer",
    "lint:prettier": "prettier --check .",
    "lint:syncpack": "syncpack lint",
    "lint:types:server": "npm --prefix ./packages/server run build",
    "lint:types:storage": "npm --prefix ./packages/storage run lint:types",
    "lint:types:web": "npm --prefix ./packages/web run lint:types",
    "postinstall": "concurrently npm:install:server npm:install:cli npm:install:web npm:install:storage",
    "serve": "NODE_ENV=production concurrently --kill-others npm:start:*",
    "setup": "npm --prefix ./packages/cli run setup",
    "start": "npm run clean && NODE_ENV=development concurrently --kill-others npm:start:*",
    "start:emulators": "firebase emulators:start --import=./.firebase/emulator-data --export-on-exit",
    "start:server": "npm --prefix ./packages/server start",
    "start:vite": "npm --prefix ./packages/web run start:vite",
    "start:vite-sw": "npm --prefix ./packages/web run start:vite-sw",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@html-eslint/eslint-plugin": "^0.66.1",
    "@html-eslint/parser": "^0.66.1",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.2.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "firebase-tools": "^15.5.1",
    "globals": "^17.11.0",
    "jest-dev-server": "^11.0.0",
    "jsdom": "^30.1.1",
    "prettier": "3.9.8",
    "prettier-plugin-package": "2.0.0",
    "syncpack": "^15.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "contributors": [
    "Oleh Zasadnyy, GDG Lviv",
    "Sophie Huts, GDG Lviv",
    "Abraham Williams, GDG Madison"
  ]
}
