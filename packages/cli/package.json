{
  "name": "@hoverboard/cli",
  "version": "0.1.0",
  "private": true,
  "description": "CLI to help developers set up, run, and deploy the Hoverboard site",
  "type": "module",
  "bin": {
    "hoverboard": "bin/hoverboard.js",
    "hbd": "bin/hoverboard.js"
  },
  "engines": {
    "node": "22",
    "npm": "10"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "start": "tsx src/index.ts",
    "doctor": "tsx src/index.ts doctor",
    "setup": "tsx src/index.ts setup",
    "emulators": "tsx src/index.ts emulators",
    "deploy": "tsx src/index.ts deploy",
    "firestore-copy": "tsx src/index.ts firestore-copy",
    "firestore-copy:production": "FIRESTORE_TARGET=production tsx src/index.ts firestore-copy",
    "firestore-export": "tsx src/index.ts firestore-export",
    "firestore-init": "tsx src/index.ts firestore-init",
    "firestore-init:production": "FIRESTORE_TARGET=production tsx src/index.ts firestore-init"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "firebase-admin": "^14.4.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
