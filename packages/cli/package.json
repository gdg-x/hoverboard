{
  "name": "@hoverboard/cli",
  "version": "0.1.0",
  "private": true,
  "description": "CLI to help developers set up, run, and deploy the Hoverboard site",
  "type": "module",
  "bin": {
    "hoverboard": "bin/hoverboard.js"
  },
  "engines": {
    "node": "22",
    "npm": "10"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "start": "tsx src/index.ts",
    "doctor": "tsx src/index.ts doctor"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
