{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hoverboard.dev/schemas/content.schema.json",
  "title": "Hoverboard content",
  "description": "The event content model, independent of how it is stored or shown. `$defs` describes each Firestore document. The root describes the seed file `docs/default-firebase-data.json`.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "blog": {
      "description": "Blog posts by ID.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/post" }
    },
    "config": {
      "description": "Runtime settings for functions, stored in the `config` collection. Not event content.",
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "gallery": {
      "description": "Gallery photo URLs, in display order.",
      "type": "array",
      "items": { "type": "string" }
    },
    "partners": {
      "description": "Partner groups with their partners, in display order.",
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [{ "$ref": "#/$defs/partnerGroup" }],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/$defs/partner" } }
        },
        "required": ["items"],
        "unevaluatedProperties": false
      }
    },
    "previousSpeakers": {
      "description": "Speakers from earlier editions by ID.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/previousSpeaker" }
    },
    "sessions": {
      "description": "Sessions by ID.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/session" }
    },
    "speakers": {
      "description": "Speakers by ID.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/speaker" }
    },
    "team": {
      "description": "Teams with their members, in display order.",
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [{ "$ref": "#/$defs/team" }],
        "properties": {
          "members": { "type": "array", "items": { "$ref": "#/$defs/member" } }
        },
        "required": ["members"],
        "unevaluatedProperties": false
      }
    },
    "tickets": {
      "description": "Tickets, in display order.",
      "type": "array",
      "items": { "$ref": "#/$defs/ticket" }
    },
    "videos": {
      "description": "Featured videos, in display order.",
      "type": "array",
      "items": { "$ref": "#/$defs/video" }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "time": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
    "order": {
      "description": "Sort position. Lower comes first.",
      "type": ["number", "string"]
    },
    "source": {
      "description": "Where the record was imported from, for example `sessionize`. Absent for records edited in Hoverboard.",
      "type": "string"
    },
    "externalId": {
      "description": "The record's ID in `source`, so a later import updates it instead of adding a duplicate.",
      "type": "string"
    },
    "link": {
      "description": "An http, https or mailto URL, or a path on the site. Other schemes, such as `javascript:`, could run code when clicked.",
      "type": "string",
      "pattern": "^(?![\\s\\u0000-\\u001f])(?!.*[\\t\\n\\r])(?:https?://|mailto:|(?![A-Za-z][A-Za-z0-9+.-]*:)(?!//))"
    },
    "social": {
      "type": "object",
      "additionalProperties": false,
      "required": ["icon", "link", "name"],
      "properties": {
        "icon": { "type": "string" },
        "link": { "$ref": "#/$defs/link" },
        "name": { "type": "string" }
      }
    },
    "badge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "link", "name"],
      "properties": {
        "description": { "type": "string" },
        "link": { "$ref": "#/$defs/link" },
        "name": { "type": "string" }
      }
    },
    "post": {
      "description": "A blog post. Firestore: `blog/{postId}`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["backgroundColor", "brief", "content", "image", "published", "title"],
      "properties": {
        "backgroundColor": { "type": "string" },
        "brief": { "type": "string" },
        "content": { "type": "string" },
        "image": { "$ref": "#/$defs/link" },
        "published": { "$ref": "#/$defs/date" },
        "source": {
          "description": "Path to a markdown file with the full post.",
          "$ref": "#/$defs/link"
        },
        "title": { "type": "string" }
      }
    },
    "photo": {
      "description": "A gallery photo. Firestore: `gallery/{photoId}`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "order"],
      "properties": {
        "url": { "$ref": "#/$defs/link" },
        "order": { "$ref": "#/$defs/order" }
      }
    },
    "partnerGroup": {
      "description": "A group of partners, such as a sponsor level. Firestore: `partners/{groupId}`.",
      "type": "object",
      "required": ["order", "title"],
      "properties": {
        "order": { "$ref": "#/$defs/order" },
        "title": { "type": "string" }
      }
    },
    "partnerGroupDocument": {
      "$ref": "#/$defs/partnerGroup",
      "unevaluatedProperties": false
    },
    "partner": {
      "description": "A partner in a group. Firestore: `partners/{groupId}/items/{partnerId}`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["logoUrl", "name", "order", "url"],
      "properties": {
        "logoUrl": { "$ref": "#/$defs/link" },
        "name": { "type": "string" },
        "order": { "$ref": "#/$defs/order" },
        "url": { "$ref": "#/$defs/link" }
      }
    },
    "previousSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tags", "title"],
      "properties": {
        "presentation": { "$ref": "#/$defs/link" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "title": { "type": "string" },
        "videoId": { "type": "string" }
      }
    },
    "previousSpeaker": {
      "description": "A speaker from an earlier edition. Firestore: `previousSpeakers/{speakerId}`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bio",
        "company",
        "country",
        "id",
        "name",
        "order",
        "photoUrl",
        "sessions",
        "socials",
        "title"
      ],
      "properties": {
        "bio": { "type": "string" },
        "company": { "type": "string" },
        "companyLogo": { "$ref": "#/$defs/link" },
        "country": { "type": "string" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "order": { "$ref": "#/$defs/order" },
        "photoUrl": { "$ref": "#/$defs/link" },
        "sessions": {
          "description": "Sessions by year.",
          "type": "object",
          "propertyNames": { "pattern": "^\\d{4}$" },
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/previousSession" }
          }
        },
        "socials": { "type": "array", "items": { "$ref": "#/$defs/social" } },
        "title": { "type": "string" }
      }
    },
    "session": {
      "description": "A session. Firestore: `sessions/{sessionId}`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "title"],
      "properties": {
        "complexity": { "type": "string" },
        "day": {
          "description": "The day of the session. Without it, the session is not on the schedule yet.",
          "$ref": "#/$defs/date"
        },
        "description": { "type": "string" },
        "endTime": {
          "description": "When the session ends, in the event time zone.",
          "$ref": "#/$defs/time"
        },
        "externalId": { "$ref": "#/$defs/externalId" },
        "icon": { "type": "string" },
        "image": { "$ref": "#/$defs/link" },
        "language": { "type": "string" },
        "presentation": { "$ref": "#/$defs/link" },
        "source": { "$ref": "#/$defs/source" },
        "speakers": {
          "description": "Speaker IDs.",
          "type": "array",
          "items": { "type": "string" }
        },
        "startTime": {
          "description": "When the session starts, in the event time zone.",
          "$ref": "#/$defs/time"
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "title": { "type": "string" },
        "track": {
          "description": "A track ID from `schedule.tracks` in site.json. Without it, the session spans every track.",
          "type": "string"
        },
        "videoId": { "type": "string" }
      },
      "dependentRequired": {
        "day": ["startTime", "endTime"],
        "startTime": ["day", "endTime"],
        "endTime": ["day", "startTime"],
        "track": ["day"]
      }
    },
    "speaker": {
      "description": "A speaker. Firestore: `speakers/{speakerId}`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bio",
        "company",
        "companyLogo",
        "companyLogoUrl",
        "country",
        "featured",
        "name",
        "photo",
        "photoUrl",
        "shortBio",
        "socials",
        "title"
      ],
      "properties": {
        "badges": { "type": "array", "items": { "$ref": "#/$defs/badge" } },
        "bio": { "type": "string" },
        "company": { "type": "string" },
        "companyLogo": { "$ref": "#/$defs/link" },
        "companyLogoUrl": { "$ref": "#/$defs/link" },
        "country": { "type": "string" },
        "externalId": { "$ref": "#/$defs/externalId" },
        "featured": { "type": "boolean" },
        "name": { "type": "string" },
        "order": {
          "description": "The place of a featured speaker in the home page's speakers block. Without it on any, they shuffle.",
          "$ref": "#/$defs/order"
        },
        "photo": { "$ref": "#/$defs/link" },
        "photoUrl": { "$ref": "#/$defs/link" },
        "pronouns": { "type": "string" },
        "shortBio": { "type": "string" },
        "socials": { "type": "array", "items": { "$ref": "#/$defs/social" } },
        "source": { "$ref": "#/$defs/source" },
        "title": { "type": "string" }
      }
    },
    "team": {
      "description": "A team. Firestore: `team/{teamId}`.",
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" }
      }
    },
    "teamDocument": {
      "$ref": "#/$defs/team",
      "unevaluatedProperties": false
    },
    "member": {
      "description": "A team member. Firestore: `team/{teamId}/members/{memberId}`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "order", "photo", "photoUrl", "socials", "title"],
      "properties": {
        "name": { "type": "string" },
        "order": { "$ref": "#/$defs/order" },
        "photo": { "$ref": "#/$defs/link" },
        "photoUrl": { "$ref": "#/$defs/link" },
        "socials": { "type": "array", "items": { "$ref": "#/$defs/social" } },
        "title": { "type": "string" }
      }
    },
    "ticket": {
      "description": "A ticket. Firestore: `tickets/{ticketId}`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "currency", "info", "name", "price", "soldOut", "url"],
      "properties": {
        "available": { "type": "boolean" },
        "currency": { "type": "string" },
        "ends": { "type": "string" },
        "inDemand": { "type": "boolean" },
        "info": { "type": "string" },
        "name": { "type": "string" },
        "order": { "$ref": "#/$defs/order" },
        "price": { "type": "number" },
        "primary": { "type": "boolean" },
        "regular": { "type": "boolean" },
        "soldOut": { "type": "boolean" },
        "starts": { "type": "string" },
        "url": { "$ref": "#/$defs/link" }
      }
    },
    "video": {
      "description": "A featured video. Firestore: `videos/{videoId}`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["speakers", "thumbnail", "title", "youtubeId"],
      "properties": {
        "order": { "$ref": "#/$defs/order" },
        "speakers": { "type": "string" },
        "thumbnail": { "$ref": "#/$defs/link" },
        "title": { "type": "string" },
        "youtubeId": { "type": "string" }
      }
    }
  }
}
