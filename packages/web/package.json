{
  "name": "@hoverboard/web",
  "version": "3.0.0",
  "private": true,
  "description": "Hoverboard conference website frontend (Lit + Redux Toolkit PWA)",
  "type": "module",
  "engines": {
    "node": "22",
    "npm": "10"
  },
  "scripts": {
    "build": "npm run clean && NODE_ENV=production VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build && NODE_ENV=production VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build --config vite.sw.config.ts",
    "clean": "rm -rf dist",
    "lint:lit-analyzer": "lit-analyzer 'src/**/*.ts' --rules.no-incompatible-type-binding off",
    "lint:types": "tsc --noEmit",
    "start:vite": "mkdir -p dist && VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build --watch",
    "start:vite-sw": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build --watch --config vite.sw.config.ts"
  },
  "dependencies": {
    "@abraham/remotedata": "1.4.0",
    "@justinribeiro/lite-youtube": "^1.9.0",
    "@lit-labs/observers": "^2.1.0",
    "@lit-labs/router": "^0.1.4",
    "@material/web": "^2.5.0",
    "@reduxjs/toolkit": "^2.13.0",
    "dompurify": "^3.4.16",
    "firebase": "^12.19.0",
    "lit": "^3.3.3",
    "marked": "^18.0.11",
    "marked-gfm-heading-id": "^4.1.4",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^22.20.4",
    "@types/nunjucks": "^3.2.6",
    "ajv": "^8.20.0",
    "lit-analyzer": "^2.0.3",
    "nunjucks": "^3.2.4",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-workbox": "^9.0.0",
    "typescript": "^6.0.3",
    "urlpattern-polyfill": "^10.1.0",
    "vite": "^8.3.2"
  }
}
