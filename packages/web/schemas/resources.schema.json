{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hoverboard.dev/schemas/resources.schema.json",
  "title": "Hoverboard content",
  "description": "packages/config/content/resources.json: event text. UI text defaults come from packages/web/defaults/content/resources.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "description",
    "keywords",
    "dates",
    "aboutBlock",
    "aboutOrganizerBlock",
    "team",
    "ticketsBlock",
    "featuredVideos",
    "galleryBlock",
    "subscribeBlock",
    "codeOfConductBlock",
    "footerRelBlock",
    "mapBlock"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "buyTicket": {
      "type": "string"
    },
    "viewHighlights": {
      "type": "string"
    },
    "faq": {
      "type": "string"
    },
    "coc": {
      "type": "string"
    },
    "loading": {
      "type": "string"
    },
    "ticketsBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticketsDetails"],
      "properties": {
        "title": {
          "type": "string"
        },
        "soldOut": {
          "type": "string"
        },
        "notAvailableYet": {
          "type": "string"
        },
        "save": {
          "type": "string"
        },
        "ticketsDetails": {
          "type": "string"
        }
      }
    },
    "partnersBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "button": {
          "type": "string"
        },
        "form": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            },
            "submitLabel": {
              "type": "string"
            },
            "fullName": {
              "type": "string"
            },
            "companyName": {
              "type": "string"
            }
          }
        },
        "toast": {
          "type": "string"
        }
      }
    },
    "featuredVideos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "callToAction"],
      "properties": {
        "callToAction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["link"],
          "properties": {
            "label": {
              "type": "string"
            },
            "link": {
              "type": "string"
            }
          }
        },
        "title": {
          "type": "string"
        }
      }
    },
    "latestPostsBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "callToAction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "link": {
              "type": "string"
            }
          }
        }
      }
    },
    "speakersBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "callToAction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "link": {
              "type": "string"
            }
          }
        }
      }
    },
    "galleryBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "callToAction"],
      "properties": {
        "callToAction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["link"],
          "properties": {
            "label": {
              "type": "string"
            },
            "link": {
              "type": "string"
            }
          }
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "mapBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "subscribeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formTitle"],
      "properties": {
        "formTitle": {
          "type": "string"
        }
      }
    },
    "aboutBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callToAction", "statisticsBlock"],
      "properties": {
        "title": {
          "type": "string"
        },
        "callToAction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["featuredSessions", "howItWas"],
          "properties": {
            "featuredSessions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["description", "label", "link"],
              "properties": {
                "description": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "link": {
                  "type": "string"
                }
              }
            },
            "howItWas": {
              "type": "object",
              "additionalProperties": false,
              "required": ["description", "label", "youtubeId"],
              "properties": {
                "description": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "youtubeId": {
                  "type": "string"
                }
              }
            }
          }
        },
        "statisticsBlock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attendees", "days", "sessions", "tracks"],
          "properties": {
            "attendees": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "number"],
              "properties": {
                "label": {
                  "type": "string"
                },
                "number": {
                  "type": "string"
                }
              }
            },
            "days": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "number"],
              "properties": {
                "label": {
                  "type": "string"
                },
                "number": {
                  "type": "string"
                }
              }
            },
            "sessions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "number"],
              "properties": {
                "label": {
                  "type": "string"
                },
                "number": {
                  "type": "string"
                }
              }
            },
            "tracks": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "number"],
              "properties": {
                "label": {
                  "type": "string"
                },
                "number": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "keywords": {
      "type": "string"
    },
    "dates": {
      "type": "string"
    },
    "aboutOrganizerBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "blocks"],
      "properties": {
        "image": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "description", "callToAction"],
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "callToAction": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "link"],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "link": {
                    "type": "string"
                  },
                  "newTab": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": {
          "type": "string"
        }
      }
    },
    "codeOfConductBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form", "contacts"],
      "properties": {
        "form": {
          "type": "string"
        },
        "contacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "footerRelBlock": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "links"],
        "properties": {
          "title": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "url", "newTab"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "newTab": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
