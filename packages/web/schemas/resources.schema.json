{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hoverboard.dev/schemas/resources.schema.json",
  "title": "Hoverboard content",
  "description": "packages/config/content/resources.json: event text. The UI text is in the app's source and in packages/translations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "description",
    "keywords",
    "heroDescriptions",
    "aboutBlock",
    "aboutOrganizerBlock",
    "team",
    "ticketsBlock",
    "featuredVideos",
    "galleryBlock",
    "subscribeBlock",
    "codeOfConductBlock",
    "footerRelBlock",
    "mapBlock"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "heroDescriptions": {
      "description": "Text under the title in the top block of each page. Only home is required.",
      "type": "object",
      "additionalProperties": false,
      "required": ["home"],
      "properties": {
        "home": { "type": "string" },
        "attending": { "type": "string" },
        "blog": { "type": "string" },
        "coc": { "type": "string" },
        "faq": { "type": "string" },
        "notFound": { "type": "string" },
        "offline": { "type": "string" },
        "previousSpeakers": { "type": "string" },
        "schedule": { "type": "string" },
        "speakers": { "type": "string" },
        "team": { "type": "string" }
      }
    },
    "ticketsBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticketsDetails"],
      "properties": {
        "ticketsDetails": {
          "type": "string"
        }
      }
    },
    "featuredVideos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "callToAction"],
      "properties": {
        "callToAction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["link"],
          "properties": {
            "link": { "$ref": "#/$defs/link" }
          }
        },
        "title": {
          "type": "string"
        }
      }
    },
    "galleryBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "callToAction"],
      "properties": {
        "callToAction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["link"],
          "properties": {
            "link": { "$ref": "#/$defs/link" }
          }
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "mapBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": {
          "type": "string"
        }
      }
    },
    "attendingPage": {
      "description": "What only the organizers know for the attending page. The venue, the map and the stream come from site.json. Every field is optional, and a section without content is left out. Text fields are short markdown.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "description": "The page's description for search and link previews. The text under the hero is heroDescriptions.attending.",
          "type": "string"
        },
        "photo": {
          "description": "A photo of the venue, next to its address.",
          "$ref": "#/$defs/image"
        },
        "floorPlan": {
          "description": "The venue's floor plan. It opens full size in a new tab.",
          "$ref": "#/$defs/image"
        },
        "online": {
          "description": "How to take part online, under the link to the stream. Online and hybrid events only.",
          "type": "string"
        },
        "gettingThere": {
          "description": "Each way to get to the venue, in the order to show them.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "text"],
            "if": { "properties": { "mode": { "const": "other" } } },
            "then": { "required": ["title"] },
            "properties": {
              "mode": {
                "description": "Picks the icon and the heading, such as \"By train\". `other` needs a title.",
                "enum": [
                  "train",
                  "plane",
                  "bus",
                  "tram",
                  "metro",
                  "car",
                  "parking",
                  "bike",
                  "walk",
                  "other"
                ]
              },
              "title": {
                "description": "Replaces the heading, for example \"By tram line 1\".",
                "type": "string",
                "minLength": 1
              },
              "text": { "type": "string" }
            }
          }
        },
        "doors": {
          "description": "When the doors open and close each day, in event.timezone.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["day", "open", "close"],
            "properties": {
              "day": {
                "description": "A day between event.startDate and event.endDate.",
                "$ref": "#/$defs/date"
              },
              "open": { "$ref": "#/$defs/time" },
              "close": { "$ref": "#/$defs/time" },
              "note": { "type": "string" }
            }
          }
        },
        "accessibility": {
          "description": "Step-free access, toilets, seating, quiet spaces and how to ask for help.",
          "type": "string"
        },
        "accommodation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": { "type": "string" },
            "hotels": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "address": { "type": "string" },
                  "note": { "type": "string" },
                  "code": {
                    "description": "A discount code, which visitors can copy.",
                    "type": "string"
                  },
                  "url": {
                    "description": "Where to book.",
                    "$ref": "#/$defs/link"
                  }
                }
              }
            }
          }
        },
        "atVenue": {
          "description": "Practical details at the venue, in the order to show them.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["topic", "text"],
            "if": { "properties": { "topic": { "const": "other" } } },
            "then": { "required": ["title"] },
            "properties": {
              "topic": {
                "description": "Picks the icon and the heading, such as \"Wi-Fi\". `other` needs a title.",
                "enum": [
                  "wifi",
                  "food",
                  "cloakroom",
                  "firstAid",
                  "quietRoom",
                  "lostAndFound",
                  "childcare",
                  "other"
                ]
              },
              "title": {
                "description": "Replaces the heading.",
                "type": "string",
                "minLength": 1
              },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "subscribeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formTitle"],
      "properties": {
        "formTitle": {
          "type": "string"
        }
      }
    },
    "aboutBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callToAction", "statisticsBlock"],
      "properties": {
        "callToAction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["featuredSessions", "howItWas"],
          "properties": {
            "featuredSessions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["description", "label", "link"],
              "properties": {
                "description": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "link": { "$ref": "#/$defs/link" }
              }
            },
            "howItWas": {
              "type": "object",
              "additionalProperties": false,
              "required": ["description", "label", "youtubeId"],
              "properties": {
                "description": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "youtubeId": {
                  "type": "string"
                }
              }
            }
          }
        },
        "statisticsBlock": {
          "description": "The numbers next to the about text on the home page.",
          "type": "object",
          "additionalProperties": false,
          "required": ["attendees", "days", "sessions", "tracks"],
          "properties": {
            "attendees": { "$ref": "#/$defs/statistic" },
            "days": { "$ref": "#/$defs/statistic" },
            "sessions": { "$ref": "#/$defs/statistic" },
            "tracks": { "$ref": "#/$defs/statistic" }
          }
        }
      }
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "keywords": {
      "type": "string"
    },
    "aboutOrganizerBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "blocks"],
      "properties": {
        "image": { "$ref": "#/$defs/link" },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "description", "callToAction"],
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "callToAction": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "link"],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "link": { "$ref": "#/$defs/link" },
                  "newTab": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": {
          "type": "string"
        }
      }
    },
    "codeOfConductBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form", "contacts"],
      "properties": {
        "form": {
          "type": "string"
        },
        "contacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "footerRelBlock": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "links"],
        "properties": {
          "title": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "url", "newTab"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "url": { "$ref": "#/$defs/link" },
                "newTab": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "link": {
      "description": "An http, https or mailto URL, or a path on the site. Other schemes, such as `javascript:`, could run code when clicked.",
      "type": "string",
      "pattern": "^(?![\\s\\u0000-\\u001f])(?!.*[\\t\\n\\r])(?:https?://|mailto:|(?![A-Za-z][A-Za-z0-9+.-]*:)(?!//))"
    },
    "date": {
      "description": "An ISO date, for example 2027-10-15.",
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "time": {
      "description": "A time of day, HH:MM, for example 08:30.",
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "alt"],
      "properties": {
        "image": {
          "description": "A path in packages/web/public, such as /images/venue.jpg, or a URL.",
          "$ref": "#/$defs/link"
        },
        "alt": {
          "description": "What the image shows, for people who can't see it.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "statistic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "number"],
      "properties": {
        "label": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "emoji": {
          "description": "Shown next to the number, for fun.",
          "type": "string"
        }
      }
    }
  }
}
