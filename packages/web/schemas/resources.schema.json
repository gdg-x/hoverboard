{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hoverboard.dev/schemas/resources.schema.json",
  "title": "Hoverboard content",
  "description": "packages/config/content/resources.json: event text. The UI text is in the app's source and in packages/translations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "description",
    "keywords",
    "heroDescriptions",
    "aboutBlock",
    "aboutOrganizerBlock",
    "team",
    "ticketsBlock",
    "featuredVideos",
    "galleryBlock",
    "subscribeBlock",
    "codeOfConductBlock",
    "footerRelBlock",
    "mapBlock"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "heroDescriptions": {
      "description": "Text under the title in the top block of each page. Only home is required.",
      "type": "object",
      "additionalProperties": false,
      "required": ["home"],
      "properties": {
        "home": { "type": "string" },
        "attending": { "type": "string" },
        "blog": { "type": "string" },
        "coc": { "type": "string" },
        "faq": { "type": "string" },
        "notFound": { "type": "string" },
        "offline": { "type": "string" },
        "previousSpeakers": { "type": "string" },
        "schedule": { "type": "string" },
        "speakers": { "type": "string" },
        "team": { "type": "string" }
      }
    },
    "ticketsBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticketsDetails"],
      "properties": {
        "ticketsDetails": {
          "type": "string"
        }
      }
    },
    "featuredVideos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "callToAction"],
      "properties": {
        "callToAction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["link"],
          "properties": {
            "link": { "$ref": "#/$defs/link" }
          }
        },
        "title": {
          "type": "string"
        }
      }
    },
    "galleryBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "callToAction"],
      "properties": {
        "callToAction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["link"],
          "properties": {
            "link": { "$ref": "#/$defs/link" }
          }
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "mapBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": {
          "type": "string"
        }
      }
    },
    "subscribeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formTitle"],
      "properties": {
        "formTitle": {
          "type": "string"
        }
      }
    },
    "aboutBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callToAction", "statisticsBlock"],
      "properties": {
        "callToAction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["featuredSessions", "howItWas"],
          "properties": {
            "featuredSessions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["description", "label", "link"],
              "properties": {
                "description": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "link": { "$ref": "#/$defs/link" }
              }
            },
            "howItWas": {
              "type": "object",
              "additionalProperties": false,
              "required": ["description", "label", "youtubeId"],
              "properties": {
                "description": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "youtubeId": {
                  "type": "string"
                }
              }
            }
          }
        },
        "statisticsBlock": {
          "description": "The numbers next to the about text on the home page.",
          "type": "object",
          "additionalProperties": false,
          "required": ["attendees", "days", "sessions", "tracks"],
          "properties": {
            "attendees": { "$ref": "#/$defs/statistic" },
            "days": { "$ref": "#/$defs/statistic" },
            "sessions": { "$ref": "#/$defs/statistic" },
            "tracks": { "$ref": "#/$defs/statistic" }
          }
        }
      }
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "keywords": {
      "type": "string"
    },
    "aboutOrganizerBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "blocks"],
      "properties": {
        "image": { "$ref": "#/$defs/link" },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "description", "callToAction"],
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "callToAction": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "link"],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "link": { "$ref": "#/$defs/link" },
                  "newTab": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": {
          "type": "string"
        }
      }
    },
    "codeOfConductBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form", "contacts"],
      "properties": {
        "form": {
          "type": "string"
        },
        "contacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "footerRelBlock": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "links"],
        "properties": {
          "title": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "url", "newTab"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "url": { "$ref": "#/$defs/link" },
                "newTab": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "link": {
      "description": "An http, https or mailto URL, or a path on the site. Other schemes, such as `javascript:`, could run code when clicked.",
      "type": "string",
      "pattern": "^(?![\\s\\u0000-\\u001f])(?!.*[\\t\\n\\r])(?:https?://|mailto:|(?![A-Za-z][A-Za-z0-9+.-]*:)(?!//))"
    },
    "statistic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "number"],
      "properties": {
        "label": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "emoji": {
          "description": "Shown next to the number, for fun.",
          "type": "string"
        }
      }
    }
  }
}
