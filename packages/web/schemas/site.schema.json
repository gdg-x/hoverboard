{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hoverboard.dev/schemas/site.schema.json",
  "title": "Hoverboard site config",
  "description": "packages/config/site.json. Only the values a site changes need to be set. Defaults come from packages/web/defaults/site.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["firebase", "shortName", "organizer", "event", "social"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "firebase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId"],
      "properties": {
        "projectId": {
          "description": "The Firebase project the site deploys to.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
        }
      }
    },
    "url": {
      "description": "The site's canonical URL, ending with a slash. Defaults to https://<firebase.projectId>.web.app/. Set it for a custom domain.",
      "type": "string",
      "pattern": "^https?://.+/$"
    },
    "basepath": {
      "description": "The path the site is served from, starting and ending with a slash.",
      "type": "string",
      "pattern": "^/(.*/)?$"
    },
    "shortName": {
      "description": "The name shown under the home screen icon.",
      "type": "string",
      "minLength": 1
    },
    "image": {
      "description": "The image shown when the site is shared. A path in packages/web/public, or a full URL.",
      "type": "string",
      "minLength": 1
    },
    "organizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "blog": {
          "$ref": "#/$defs/url"
        },
        "email": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "twitter": {
          "description": "A handle, without the @.",
          "type": "string"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startDate", "endDate", "timezone", "location"],
      "properties": {
        "startDate": {
          "$ref": "#/$defs/date"
        },
        "endDate": {
          "$ref": "#/$defs/date"
        },
        "timezone": {
          "description": "The IANA time zone of the event, for example Europe/Kyiv. Session times are in this time zone.",
          "type": "string",
          "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)*$"
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "city", "short", "address", "pointer", "mapCenter"],
          "properties": {
            "name": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "short": {
              "type": "string"
            },
            "address": {
              "type": "string"
            },
            "pointer": {
              "description": "The map marker.",
              "type": "object",
              "additionalProperties": false,
              "required": ["latitude", "longitude", "zoom"],
              "properties": {
                "latitude": {
                  "$ref": "#/$defs/latitude"
                },
                "longitude": {
                  "$ref": "#/$defs/longitude"
                },
                "zoom": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 22
                }
              }
            },
            "mapCenter": {
              "type": "object",
              "additionalProperties": false,
              "required": ["latitude", "longitude"],
              "properties": {
                "latitude": {
                  "$ref": "#/$defs/latitude"
                },
                "longitude": {
                  "$ref": "#/$defs/longitude"
                }
              }
            }
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "published": {
          "description": "Shows session times and tracks. Keep it false until the schedule is final.",
          "type": "boolean"
        }
      }
    },
    "social": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hashtag", "follow"],
      "properties": {
        "hashtag": {
          "description": "Without the #.",
          "type": "string",
          "pattern": "^[^#\\s]+$"
        },
        "follow": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url"],
            "properties": {
              "name": {
                "description": "The icon name, for example twitter.",
                "type": "string"
              },
              "url": {
                "$ref": "#/$defs/url"
              }
            }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providers": {
          "description": "Sign-in providers, in the order they are shown.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["google", "facebook", "twitter"]
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "The built-in theme.",
          "enum": ["default"]
        },
        "colors": {
          "description": "Overrides for colors of the theme.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary": {
              "$ref": "#/$defs/color"
            },
            "primaryDark": {
              "$ref": "#/$defs/color"
            },
            "focused": {
              "$ref": "#/$defs/color"
            },
            "accent": {
              "$ref": "#/$defs/color"
            },
            "onPrimary": {
              "$ref": "#/$defs/color"
            },
            "background": {
              "$ref": "#/$defs/color"
            },
            "defaultBackground": {
              "$ref": "#/$defs/color"
            },
            "secondaryBackground": {
              "$ref": "#/$defs/color"
            },
            "additionalBackground": {
              "$ref": "#/$defs/color"
            },
            "contrastAdditionalBackground": {
              "$ref": "#/$defs/color"
            },
            "text": {
              "$ref": "#/$defs/color"
            },
            "secondaryText": {
              "$ref": "#/$defs/color"
            },
            "disabledText": {
              "$ref": "#/$defs/color"
            },
            "divider": {
              "$ref": "#/$defs/color"
            },
            "borderLight": {
              "$ref": "#/$defs/color"
            },
            "footerBackground": {
              "$ref": "#/$defs/color"
            },
            "footerText": {
              "$ref": "#/$defs/color"
            },
            "error": {
              "$ref": "#/$defs/color"
            },
            "snackbarBackground": {
              "$ref": "#/$defs/color"
            },
            "snackbarText": {
              "$ref": "#/$defs/color"
            },
            "starRating": {
              "$ref": "#/$defs/color"
            },
            "twitter": {
              "$ref": "#/$defs/color"
            },
            "facebook": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "tagColors": {
          "description": "Session tag colors by tag name, in lowercase with dashes instead of spaces.",
          "$ref": "#/$defs/colors"
        },
        "badgeColors": {
          "description": "Speaker badge colors by badge name.",
          "$ref": "#/$defs/colors"
        }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "googleMapsApiKey": {
          "description": "A browser key, restricted by HTTP referrer to the site's domains. Required when the map feature is on.",
          "type": "string"
        }
      }
    },
    "navigation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route", "permalink"],
        "properties": {
          "route": {
            "description": "home, or a feature that has a page. The label comes from the UI text, in the current locale.",
            "type": "string"
          },
          "permalink": {
            "type": "string",
            "pattern": "^/"
          }
        }
      }
    },
    "heroSettings": {
      "description": "The top block of each page.",
      "type": "object",
      "additionalProperties": false,
      "required": ["home"],
      "properties": {
        "home": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "background"],
          "properties": {
            "description": {
              "type": "string"
            },
            "background": {
              "type": "object",
              "additionalProperties": false,
              "required": ["image"],
              "properties": {
                "image": {
                  "type": "string"
                }
              }
            }
          }
        },
        "blog": {
          "$ref": "#/$defs/hero"
        },
        "speakers": {
          "$ref": "#/$defs/hero"
        },
        "previousSpeakers": {
          "$ref": "#/$defs/hero"
        },
        "schedule": {
          "$ref": "#/$defs/hero"
        },
        "team": {
          "$ref": "#/$defs/hero"
        },
        "faq": {
          "$ref": "#/$defs/hero"
        },
        "coc": {
          "$ref": "#/$defs/hero"
        },
        "notFound": {
          "$ref": "#/$defs/hero"
        }
      }
    },
    "features": {
      "description": "Turns site features on or off. Every feature is on by default, except forkMe.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blog": {
          "type": "boolean"
        },
        "codeOfConduct": {
          "type": "boolean"
        },
        "faq": {
          "type": "boolean"
        },
        "feedback": {
          "type": "boolean"
        },
        "forkMe": {
          "type": "boolean"
        },
        "gallery": {
          "type": "boolean"
        },
        "imageOptimization": {
          "type": "boolean"
        },
        "mailchimp": {
          "type": "boolean"
        },
        "map": {
          "type": "boolean"
        },
        "mySchedule": {
          "type": "boolean"
        },
        "notifications": {
          "type": "boolean"
        },
        "partners": {
          "type": "boolean"
        },
        "previousSpeakers": {
          "type": "boolean"
        },
        "schedule": {
          "type": "boolean"
        },
        "speakers": {
          "type": "boolean"
        },
        "subscribe": {
          "type": "boolean"
        },
        "team": {
          "type": "boolean"
        },
        "tickets": {
          "type": "boolean"
        },
        "videos": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "date": {
      "description": "An ISO date, for example 2027-10-15.",
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "color": {
      "description": "A hex color, for example #673ab7.",
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "colors": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/color"
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        }
      }
    }
  }
}
