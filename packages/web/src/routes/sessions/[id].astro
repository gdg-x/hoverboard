---
import { loadContent } from '../../data/content';
import { itemMetadata } from '../../data/metadata';
import { seedPage } from '../../data/page';
import { sessionContent } from '../../data/schedule';
import type { Session } from '../../models/session';
import Base from '../../layouts/base.astro';
import { SessionPage } from '../../views/session-page';

export const getStaticPaths = async () => {
  const { sessions = [] } = await loadContent();
  return sessions.map((session) => ({ params: { id: session.id }, props: { session } }));
};

const { session } = Astro.props as { session: Session };
const content = seedPage(sessionContent(await loadContent(), session.id));
const speaker = content.speakers.find(({ id }) => id === session.speakers?.[0]);
---

<Base {...itemMetadata(session.title, session.description, speaker?.photoUrl)} content={content}>
  <SessionPage sessionId={session.id} client:load />
</Base>
