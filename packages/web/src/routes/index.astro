---
import { resources, site } from 'virtual:hoverboard/site';
import { loadContent } from '../data/content';
import { seedPage } from '../data/page';
import { contentPresence } from '../data/presence';
import { eventStructuredData, serializeJsonLd } from '../data/structured-data';
import Base from '../layouts/base.astro';
import { daysUntilStart, eventState } from '../utils/event-state';
import { HomePage, homeBlocks } from '../views/home-page';

// The home page loads these blocks without waiting, so wait here for the server to render them.
await homeBlocks;

const siteContent = await loadContent();
const { blog, speakers, tickets } = siteContent;
// The hero offers the ticket on sale.
const content = seedPage({ blog, speakers, tickets: tickets ?? [] });
// At build time. The hero checks again in the browser.
const now = new Date();
---

<Base content={content}>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={serializeJsonLd(eventStructuredData(site, resources))}
  />
  <HomePage
    eventState={eventState(now, site.event)}
    daysToGo={daysUntilStart(now, site.event)}
    time={now.getTime()}
    presence={contentPresence(siteContent)}
    client:load
  />
</Base>
