---
import { resources, site } from 'virtual:hoverboard/site';
import { loadContent } from '../data/content';
import { seedPage } from '../data/page';
import { eventStructuredData, serializeJsonLd } from '../data/structured-data';
import Base from '../layouts/base.astro';
import { daysUntilStart, eventState } from '../utils/event-state';
import { HomePage } from '../views/home-page';

// The home page imports these blocks without waiting, so wait here for the server to render them.
await Promise.all([
  __HB_FEATURES__.speakers && import('../components/home/speakers-block'),
  __HB_FEATURES__.subscribe && import('../components/home/subscribe-block'),
  __HB_FEATURES__.blog && import('../components/home/latest-posts-block'),
]);

const { blog, speakers } = await loadContent();
const content = seedPage({ blog, speakers });
// At build time. The hero checks again in the browser.
const now = new Date();
---

<Base content={content}>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={serializeJsonLd(eventStructuredData(site, resources))}
  />
  <HomePage
    eventState={eventState(now, site.event)}
    daysToGo={daysUntilStart(now, site.event)}
    client:load
  />
</Base>
