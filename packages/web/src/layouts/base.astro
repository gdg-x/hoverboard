---
import { ClientRouter } from 'astro:transitions';
import { fontCss, fontStylesheets } from 'virtual:hoverboard/fonts';
import { theme, themeCss } from 'virtual:hoverboard/layout';
import { resources, site, build } from 'virtual:hoverboard/site';
import '../styles/base.css';
import { FooterBlock } from '../components/footer/footer-block';
import { AppHeader, demoBanner } from '../components/shell/app-header';
import { AppOverlays } from '../components/shell/app-overlays';
import { loadContent } from '../data/content';
import '../data/markdown';
import { pageMetadata } from '../data/metadata';
import { seedPage } from '../data/page';
import { openGraphLocale } from '../data/structured-data';
import { type Content, PAGE_CONTENT_ID, serializeContent } from '../store/content';
import { BUILD_META } from '../utils/build';
import { colorSchemeScript } from '../utils/color-scheme';
import { demoScript } from '../utils/demo';
import { eventState } from '../utils/event-state';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** The content from `seedPage()`, which the browser's store starts from. */
  content?: Partial<Content>;
}

const {
  title = resources.title,
  description = resources.description,
  image = site.image,
  content: pageContent = {},
} = Astro.props;
// The header links to tickets on every page. The page's own content has already rendered.
const content = seedPage({ ...pageContent, tickets: (await loadContent()).tickets ?? [] });
// The build sees file paths such as /index.html. Hosting serves them without `.html`.
const path = Astro.url.pathname.replace(/(index)?\.html$/, '').slice(1);
const url = new URL(path, site.url).href;

// Local development always uses the demo project on the emulators, and `astro dev` has no `/__/`.
const demoFirebaseConfig = {
  apiKey: 'demo-api-key',
  authDomain: 'demo-hoverboard.firebaseapp.com',
  projectId: 'demo-hoverboard',
  storageBucket: 'demo-hoverboard.appspot.com',
};

// The browser toolbar color follows the color scheme, unless the site locks one. Both colors ride
// along, so the footer toggle can pick one.
const themeColors =
  theme.colorScheme === 'system'
    ? [
        { color: theme.light.primary, media: '(prefers-color-scheme: light)' },
        { color: theme.dark.primary, media: '(prefers-color-scheme: dark)' },
      ]
    : [{ color: theme[theme.colorScheme].primary, media: undefined }];
const fontOrigins = [...new Set(fontStylesheets.map((href) => new URL(href).origin))];
// At build time. The header checks again in the browser.
const builtEventState = eventState(new Date(), site.event);
// The header loads the banner without waiting, so wait here for the server to render it.
await demoBanner;
---

<!doctype html>
<html
  data-color-scheme={theme.colorScheme === 'system' ? undefined : theme.colorScheme}
  data-decorations={theme.decorations ? undefined : 'off'}
  lang={site.locales.source}
>
  <head>
    <base href={site.basepath} />
    <meta charset="utf-8" />
    <meta
      content="width=device-width, minimum-scale=1.0, initial-scale=1.0, user-scalable=yes"
      name="viewport"
    />
    <meta content={description} name="description" />
    <meta content={resources.keywords} name="keywords" />
    <meta content={site.organizer.name} name="author" />
    <meta content="Project Hoverboard" name="generator" />
    <meta content={build.time} name={BUILD_META} />

    <title>{title}</title>

    <link href={url} rel="canonical" />

    <link href="images/favicon.ico" rel="icon" />

    <meta
      content={theme.colorScheme === 'system' ? 'light dark' : theme.colorScheme}
      name="color-scheme"
    />
    {themeColors.map(({ color, media }) => (
      <meta
        content={color}
        data-dark={theme.dark.primary}
        data-light={theme.light.primary}
        media={media}
        name="theme-color"
      />
    ))}
    {/* After the theme-color tags it updates, and before any style, so the first paint is right. */}
    {theme.colorScheme === 'system' && <script is:inline set:html={colorSchemeScript} />}
    {__HB_FEATURES__.demo && <script is:inline set:html={demoScript} />}
    <link href="manifest.json" rel="manifest" />
    {__HB_FEATURES__.blog && (
      <link
        href="blog/rss.xml"
        rel="alternate"
        title={pageMetadata('blog').title}
        type="application/rss+xml"
      />
    )}

    <meta content="yes" name="mobile-web-app-capable" />
    <meta content={resources.title} name="application-name" />

    <meta content="yes" name="apple-mobile-web-app-capable" />
    <meta content="black-translucent" name="apple-mobile-web-app-status-bar-style" />
    <meta content={resources.title} name="apple-mobile-web-app-title" />

    <link href="images/manifest/icon-48.png" rel="apple-touch-icon" />
    <link href="images/manifest/icon-72.png" rel="apple-touch-icon" sizes="72x72" />
    <link href="images/manifest/icon-96.png" rel="apple-touch-icon" sizes="96x96" />
    <link href="images/manifest/icon-144.png" rel="apple-touch-icon" sizes="144x144" />
    <link href="images/manifest/icon-192.png" rel="apple-touch-icon" sizes="192x192" />

    <meta content="images/manifest/icon-144.png" name="msapplication-TileImage" />
    <meta content={theme.light.primary} name="msapplication-TileColor" />
    <meta content="no" name="msapplication-tap-highlight" />

    <meta content={title} property="og:title" />
    <meta content={resources.title} property="og:site_name" />
    <meta content="website" property="og:type" />
    <meta content={openGraphLocale(site.locales.source)} property="og:locale" />
    <meta content={url} property="og:url" />
    <meta content={description} property="og:description" />
    <meta content={image} property="og:image" />
    <meta content="image/jpeg" property="og:image:type" />

    <meta content="summary_large_image" name="twitter:card" />
    {site.organizer.twitter && (
      <meta content={`@${site.organizer.twitter}`} name="twitter:creator" />
    )}
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content={image} name="twitter:image" />
    <meta name="twitter:label1" value="Location" />
    <meta name="twitter:data1" value={site.event.location.name} />

    {fontOrigins.map((origin) => (
      <link crossorigin href={origin} rel="preconnect" />
    ))}
    <link href="https://firestore.googleapis.com" rel="preconnect" />
    {fontStylesheets.map((href) => (
      <link href={href} rel="stylesheet" />
    ))}
    <slot name="head" />

    <style is:inline set:html={themeCss} />
    <style is:inline set:html={fontCss} />

    {import.meta.env.DEV ? (
      <script is:inline define:vars={{ demoFirebaseConfig }}>
        window.firebaseConfig = demoFirebaseConfig;
      </script>
    ) : (
      <Fragment>
        <script is:inline>
          // Capture the config object from /__/firebase/init.js for src/firebase.ts
          window.firebase = {
            initializeApp: (config) => {
              window.firebaseConfig = config;
              delete window.firebase;
            },
          };
        </script>
        <script is:inline src="/__/firebase/init.js" />
      </Fragment>
    )}

    {import.meta.env.DEV && <script is:inline define:vars={{ features: site.features }}>
      // The build inlines the flags. In development Vite sets them in /@vite/env, which loads too late.
      globalThis.__HB_FEATURES__ = features;
    </script>}

    <script
      is:inline
      type="application/json"
      id={PAGE_CONTENT_ID}
      set:html={serializeContent(content)}
    />
    <script>
      import '../service-worker-registration';
      import { startApp } from '../app';

      void startApp();
    </script>
    <ClientRouter />
  </head>

  <body>
    <AppHeader
      path={`/${path}`}
      eventState={builtEventState}
      client:load
      transition:persist="header"
      transition:persist-props
    />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <FooterBlock client:load transition:persist="footer" />
    <AppOverlays client:load transition:persist="overlays" />
  </body>
</html>
