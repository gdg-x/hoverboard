---
import { resources } from 'virtual:hoverboard/site';
import Base from '../layouts/base.astro';
import { pageText } from '../utils/page-text';
import { NotFoundPage } from '../views/not-found-page';

const { title, metaDescription } = pageText('notFound');
---

<Base title={`${title} | ${resources.title}`} description={metaDescription}>
  <NotFoundPage client:load />
</Base>
